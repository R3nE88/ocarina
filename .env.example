# Copy to .env for `docker compose up`; in Dokploy put these in the app's Environment tab.
POSTGRES_PASSWORD=change-me
# Opens /comunidad?admin (moderation). Leave empty to turn moderation pages off.
ADMIN_TOKEN=change-me-too
# Distinct device reports that hide a sheet or comment until an admin reviews it.
REPORT_THRESHOLD=3
# Host port for local testing (bound to 127.0.0.1).
WEB_PORT=8000
